<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#bdffb6"
    android:orientation="vertical"
    tools:context=".paymentactivity">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete payment with Mpesa"
        android:textSize="32sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#2A9913"/>

<!--    Below is the cardview that holds all of our contents-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:layout_margin="10dp"
        app:cardElevation="15dp"
        android:backgroundTint="#DEFFDE"
        app:cardCornerRadius="30dp">

<!--        Below is a linear layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

<!--    Below is a textview where the name of the product will be binded-->
            <TextView
                android:id="@+id/txtProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arbutus"
                android:rotationX="-2"
                android:rotationY="6"
                android:text="Product Name"
                android:textAlignment="center"
                android:textAllCaps="true"
                android:textColor="#000000"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!--            Below is edittext for entering the mobile no-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!--Below is an image view for the product image-->
                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="215dp"
                    android:layout_height="191dp"
                    android:layout_marginTop="10dp"
                    android:scaleType="fitCenter"
                    android:src="@mipmap/ic_launcher" />

                <!--            Below is a textview for the product cost-->
                <TextView
                    android:id="@+id/txtProductCost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="170dp"
                    android:text="KES"
                    android:textAlignment="center"
                    android:textAppearance="@style/TextAppearance.AppCompat.Display1"
                    android:textColor="#ec252c"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/phone"
                android:hint="Enter your phone number"
                android:textColorHint="#000"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#ffffff"/>

            <TextView
                android:id="@+id/product_description"
                android:layout_width="346dp"
                android:layout_height="161dp"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="5dp"
                android:text="The product description will appear here"
                android:textColor="#000"
                android:textSize="20sp" />
            
<!--            Below is a button to complete the payment action-->
            <Button
                android:id="@+id/pay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="30dp"
                android:backgroundTint="#1DB901"
                android:text="PAY NOW"
                android:textSize="22sp" />



        </LinearLayout>



    </androidx.cardview.widget.CardView>


</LinearLayout>