<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#fff"
    android:orientation="vertical"
    tools:context=".paymentactivity">


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Complete payment with Mpesa"
        android:textSize="32sp"
        android:textAlignment="center"
        android:textStyle="bold"
        android:textColor="#2A9913"/>

<!--    Below is the cardview that holds all of our contents-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="15dp"
        android:layout_margin="10dp"
        app:cardElevation="15dp"
        android:backgroundTint="#DEFFDE"
        app:cardCornerRadius="30dp">

<!--        Below is a linear layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

<!--    Below is a textview where the name of the product will be binded-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/txtProductName"
                android:text="Product Name"
                android:textSize="20dp"
                android:textStyle="bold|italic"
                android:textColor="#000000"/>

<!--Below is an image view for the product image-->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:id="@+id/imgProduct"
                android:src="@mipmap/ic_launcher"
                android:scaleType="fitCenter"
                android:layout_marginTop="10dp"/>

<!--            Below is a textview for the product cost-->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KES"
                android:id="@+id/txtProductCost"
                android:textSize="23sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:textColor="#ec252c"/>
            
<!--            Below is edittext for entering the mobile no-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/phone"
                android:hint="Enter your phone number"
                android:textColorHint="#000"
                android:inputType="number"
                android:padding="10dp"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#ffffff"/>
            
<!--            Below is a button to complete the payment action-->
            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/pay"
                android:text="PAY NOW"
                android:layout_margin="30dp"
                android:backgroundTint="#b90801"
                android:textSize="22sp"/>



        </LinearLayout>



    </androidx.cardview.widget.CardView>


</LinearLayout>