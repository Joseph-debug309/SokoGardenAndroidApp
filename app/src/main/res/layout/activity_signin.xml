<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Signin">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SignIn"
        android:textSize="38sp"
        android:layout_margin="15dp"
        android:textAlignment="center"
        android:textStyle="bold|italic"
        android:textColor="#334"
        android:background="@drawable/shape"/>

<!--    Below is a card view-->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="22dp"
        app:cardElevation="12dp"
        android:backgroundTint="#DEFFDE"
        android:layout_margin="30dp"
        android:padding="12dp">

<!--        Linear layout that alligns content vertically-->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">


<!--            Below is the email edit text-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your email address"
                android:textColorHint="#000"
                android:id="@+id/email"
                android:padding="12dp"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#ffffff"/>

<!--            The password edit text-->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your password"
                android:textColorHint="#000"
                android:inputType="textPassword"
                android:id="@+id/password"
                android:padding="12dp"
                android:textColor="#000"
                android:layout_margin="8dp"
                android:background="#ffffff"/>

            <Button
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Signin"
                android:textSize="25sp"
                android:layout_marginRight="30dp"
                android:padding="10dp"
                android:layout_marginLeft="40dp"
                android:layout_marginTop="30dp"
                android:textColor="#E1CDD8"
                android:backgroundTint="#051232"
                android:id="@+id/signinBtn" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/signup_text"
                android:textAlignment="center"
                android:textSize="18sp"
                android:layout_marginTop="19dp"
                android:textColor="#1b42ff"
                android:id="@+id/signupTxt"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>




</LinearLayout>